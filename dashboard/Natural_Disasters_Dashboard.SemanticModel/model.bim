        "measures": [
          {
            "name": "Total Disasters",
            "expression": "COUNTROWS('Disasters')",
            "lineageTag": "8ea1f2c6-e618-4f01-b955-475c3049970f",
            "formatString": "#,0"
          },
          {
            "name": "Total Deaths",
            "expression": "SUM('Disasters'[Deaths])",
            "lineageTag": "f2107b7d-f7d6-428c-b21d-58f37e5a882c",
            "formatString": "#,0"
          },
          {
            "name": "Total Affected",
            "expression": "SUM('Disasters'[People_Affected])",
            "lineageTag": "f7dd1da2-b82d-4d86-87e1-9f1b8a643c1e",
            "formatString": "#,0"
          },
          {
            "name": "Economic Loss",
            "expression": "SUM('Disasters'[Economic_Loss_USD])",
            "lineageTag": "099a150e-2c19-4790-99a7-6b30f89a78ef",
            "formatString": "#,0"
          },
          {
            "name": "Affected Countries",
            "expression": "DISTINCTCOUNT('Disasters'[Country])",
            "lineageTag": "f6457b84-6221-41ec-a05f-6711412c3481",
            "formatString": "#,0"
          },
          {
            "name": "KPI Disasters",
            "expression": [
              "VAR n = [Total Disasters]",
              "RETURN IF(ISBLANK(n), \"0\", SUBSTITUTE(FORMAT(n, \"#,0\"), \",\", \".\"))"
            ],
            "lineageTag": "01065414-51c3-47f3-8f8b-55a83d27b72f",
            "displayFolder": "KPI Text"
          },
          {
            "name": "KPI Deaths",
            "expression": [
              "VAR d = [Total Deaths]",
              "RETURN SWITCH(TRUE(), ISBLANK(d), \"0\", d >= 1000000, FORMAT(d / 1000000, \"0.00\") & \"M\", d >= 1000, FORMAT(d / 1000, \"0.0\") & \"K\", FORMAT(d, \"0\"))"
            ],
            "lineageTag": "a275d572-3031-49a8-b3e6-531e9c12ec2d",
            "displayFolder": "KPI Text"
          },
          {
            "name": "KPI Economic Loss",
            "expression": [
              "VAR v = [Economic Loss]",
              "RETURN SWITCH(TRUE(), ISBLANK(v), \"0\", v >= 1000000000000, FORMAT(v / 1000000000000, \"0.00\") & \" تريليون\", v >= 1000000000, FORMAT(v / 1000000000, \"0.00\") & \" مليار\", v >= 1000000, FORMAT(v / 1000000, \"0.00\") & \" مليون\", FORMAT(v, \"#,0\"))"
            ],
            "lineageTag": "88592949-fb0e-47ff-a856-6b4f539148b8",
            "displayFolder": "KPI Text"
          },
          {
            "name": "KPI Affected",
            "expression": [
              "VAR v = [Total Affected]",
              "RETURN SWITCH(TRUE(), ISBLANK(v), \"0\", v >= 1000000000, FORMAT(v / 1000000000, \"0.00\") & \" مليار\", v >= 1000000, FORMAT(v / 1000000, \"0.00\") & \" مليون\", FORMAT(v, \"#,0\"))"
            ],
            "lineageTag": "dfc0a1bb-8077-4135-ade9-391b145a8faa",
            "displayFolder": "KPI Text"
          },
          {
            "name": "KPI Countries",
            "expression": "FORMAT(COALESCE([Affected Countries], 0), \"0\")",
            "lineageTag": "dfeda2f4-0c31-42f2-8ef2-d74742226541",
            "displayFolder": "KPI Text"
          },
          {
            "name": "Continent Color",
            "expression": "SWITCH(SELECTEDVALUE('Disasters'[Continent]), \"Asia\", \"#E66C37\", \"North America\", \"#6B007B\", \"South America\", \"#12239E\", \"Africa\", \"#4A90F0\", \"Europe\", \"#197278\", \"Oceania\", \"#118DFF\", \"#9AA3B5\")",
            "lineageTag": "463dbb6b-7fbb-4637-af5f-01d2c0b0038c",
            "displayFolder": "Formatting"
          }
        ],
        "partitions": [
          {
            "name": "Disasters",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // 1) يقرأ ملف CSV من المسار في الباراميتر FilePath  2) إذا ما لقاه يستخدم نسخة البيانات المدمجة تحت",
                "    FromFile = try Table.Buffer(Table.PromoteHeaders(Csv.Document(File.Contents(FilePath), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true])) otherwise null,",
                "    Embedded = Table.PromoteHeaders(Csv.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),",
                "    Source0 = if FromFile <> null then FromFile else Embedded,",
                "    Source = Table.TransformColumnNames(Source0, each Text.Trim(Text.Replace(_, \"#(feff)\", \"\"))),",
                "    Selected = Table.SelectColumns(Source, {\"Disaster_ID\", \"Date\", \"Year\", \"Month\", \"Country\", \"Disaster_Type\", \"Deaths\", \"People_Affected\", \"Economic_Loss_USD\", \"Data_Status\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"Disaster_ID\", type text}, {\"Date\", type date}, {\"Year\", Int64.Type}, {\"Month\", Int64.Type}, {\"Country\", type text}, {\"Disaster_Type\", type text}, {\"Deaths\", Int64.Type}, {\"People_Affected\", Int64.Type}, {\"Economic_Loss_USD\", Int64.Type}, {\"Data_Status\", type text}}, \"en-US\"),",
                "    ContinentMap = [#\"North Korea\" = \"Asia\", #\"South Korea\" = \"Asia\", #\"Saudi Arabia\" = \"Asia\", #\"Sri Lanka\" = \"Asia\", #\"United Arab Emirates\" = \"Asia\", #\"Afghanistan\" = \"Asia\", #\"Bangladesh\" = \"Asia\", #\"Cambodia\" = \"Asia\", #\"China\" = \"Asia\", #\"India\" = \"Asia\", #\"Indonesia\" = \"Asia\", #\"Iran\" = \"Asia\", #\"Iraq\" = \"Asia\", #\"Israel\" = \"Asia\", #\"Japan\" = \"Asia\", #\"Jordan\" = \"Asia\", #\"Kazakhstan\" = \"Asia\", #\"Laos\" = \"Asia\", #\"Lebanon\" = \"Asia\", #\"Malaysia\" = \"Asia\", #\"Mongolia\" = \"Asia\", #\"Myanmar\" = \"Asia\", #\"Nepal\" = \"Asia\", #\"Oman\" = \"Asia\", #\"Pakistan\" = \"Asia\", #\"Philippines\" = \"Asia\", #\"Singapore\" = \"Asia\", #\"Syria\" = \"Asia\", #\"Taiwan\" = \"Asia\", #\"Thailand\" = \"Asia\", #\"Turkey\" = \"Asia\", #\"Uzbekistan\" = \"Asia\", #\"Vietnam\" = \"Asia\", #\"Yemen\" = \"Asia\", #\"Cyprus\" = \"Asia\", #\"Bosnia and Herzegovina\" = \"Europe\", #\"Czechia\" = \"Europe\", #\"North Macedonia\" = \"Europe\", #\"United Kingdom\" = \"Europe\", #\"Albania\" = \"Europe\", #\"Austria\" = \"Europe\", #\"Belarus\" = \"Europe\", #\"Belgium\" = \"Europe\", #\"Bulgaria\" = \"Europe\", #\"Croatia\" = \"Europe\", #\"Denmark\" = \"Europe\", #\"Estonia\" = \"Europe\", #\"Finland\" = \"Europe\", #\"France\" = \"Europe\", #\"Germany\" = \"Europe\", #\"Greece\" = \"Europe\", #\"Hungary\" = \"Europe\", #\"Iceland\" = \"Europe\", #\"Ireland\" = \"Europe\", #\"Italy\" = \"Europe\", #\"Latvia\" = \"Europe\", #\"Lithuania\" = \"Europe\", #\"Luxembourg\" = \"Europe\", #\"Malta\" = \"Europe\", #\"Moldova\" = \"Europe\", #\"Montenegro\" = \"Europe\", #\"Netherlands\" = \"Europe\", #\"Norway\" = \"Europe\", #\"Poland\" = \"Europe\", #\"Portugal\" = \"Europe\", #\"Romania\" = \"Europe\", #\"Russia\" = \"Asia\", #\"Serbia\" = \"Europe\", #\"Slovakia\" = \"Europe\", #\"Slovenia\" = \"Europe\", #\"Spain\" = \"Europe\", #\"Sweden\" = \"Europe\", #\"Switzerland\" = \"Europe\", #\"Ukraine\" = \"Europe\", #\"Burkina Faso\" = \"Africa\", #\"Central African Republic\" = \"Africa\", #\"DR Congo\" = \"Africa\", #\"Equatorial Guinea\" = \"Africa\", #\"Ivory Coast\" = \"Africa\", #\"Sao Tome and Principe\" = \"Africa\", #\"Sierra Leone\" = \"Africa\", #\"South Africa\" = \"Africa\", #\"South Sudan\" = \"Africa\", #\"Cabo Verde\" = \"Africa\", #\"Guinea-Bissau\" = \"Africa\", #\"Algeria\" = \"Africa\", #\"Angola\" = \"Africa\", #\"Benin\" = \"Africa\", #\"Botswana\" = \"Africa\", #\"Burundi\" = \"Africa\", #\"Cameroon\" = \"Africa\", #\"Chad\" = \"Africa\", #\"Comoros\" = \"Africa\", #\"Congo\" = \"Africa\", #\"Djibouti\" = \"Africa\", #\"Egypt\" = \"Africa\", #\"Eritrea\" = \"Africa\", #\"Eswatini\" = \"Africa\", #\"Ethiopia\" = \"Africa\", #\"Gabon\" = \"Africa\", #\"Gambia\" = \"Africa\", #\"Ghana\" = \"Africa\", #\"Guinea\" = \"Africa\", #\"Kenya\" = \"Africa\", #\"Lesotho\" = \"Africa\", #\"Liberia\" = \"Africa\", #\"Libya\" = \"Africa\", #\"Madagascar\" = \"Africa\", #\"Malawi\" = \"Africa\", #\"Mali\" = \"Africa\", #\"Mauritania\" = \"Africa\", #\"Mauritius\" = \"Africa\", #\"Morocco\" = \"Africa\", #\"Mozambique\" = \"Africa\", #\"Namibia\" = \"Africa\", #\"Niger\" = \"Africa\", #\"Nigeria\" = \"Africa\", #\"Rwanda\" = \"Africa\", #\"Senegal\" = \"Africa\", #\"Seychelles\" = \"Africa\", #\"Somalia\" = \"Africa\", #\"Sudan\" = \"Africa\", #\"Tanzania\" = \"Africa\", #\"Togo\" = \"Africa\", #\"Tunisia\" = \"Africa\", #\"Uganda\" = \"Africa\", #\"Zambia\" = \"Africa\", #\"Zimbabwe\" = \"Africa\", #\"Costa Rica\" = \"North America\", #\"Dominican Republic\" = \"North America\", #\"El Salvador\" = \"North America\", #\"Trinidad and Tobago\" = \"North America\", #\"United States\" = \"North America\", #\"Bahamas\" = \"North America\", #\"Barbados\" = \"North America\", #\"Belize\" = \"North America\", #\"Canada\" = \"North America\", #\"Cuba\" = \"North America\", #\"Guatemala\" = \"North America\", #\"Haiti\" = \"North America\", #\"Honduras\" = \"North America\", #\"Jamaica\" = \"North America\", #\"Mexico\" = \"North America\", #\"Nicaragua\" = \"North America\", #\"Panama\" = \"North America\", #\"Argentina\" = \"South America\", #\"Bolivia\" = \"South America\", #\"Brazil\" = \"South America\", #\"Chile\" = \"South America\", #\"Colombia\" = \"South America\", #\"Ecuador\" = \"South America\", #\"Guyana\" = \"South America\", #\"Paraguay\" = \"South America\", #\"Peru\" = \"South America\", #\"Suriname\" = \"South America\", #\"Uruguay\" = \"South America\", #\"Venezuela\" = \"South America\", #\"New Zealand\" = \"Oceania\", #\"Papua New Guinea\" = \"Oceania\", #\"Solomon Islands\" = \"Oceania\", #\"Australia\" = \"Oceania\", #\"Fiji\" = \"Oceania\", #\"Samoa\" = \"Oceania\", #\"Tonga\" = \"Oceania\", #\"Vanuatu\" = \"Oceania\"],",
                "    ContinentAR = [#\"Asia\" = \"آسيا\", #\"Europe\" = \"أوروبا\", #\"Africa\" = \"أفريقيا\", #\"North America\" = \"أمريكا الشمالية\", #\"South America\" = \"أمريكا الجنوبية\", #\"Oceania\" = \"أوقيانوسيا\"],",
